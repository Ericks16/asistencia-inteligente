# ── Base de datos ────────────────────────────────────────────────
# En Vercel usa el Supabase Transaction Pooler (puerto 6543) y agrega:
# ?pgbouncer=true&connection_limit=1
DATABASE_URL="postgresql://user:password@localhost:5432/asistencia?schema=public"

# ── JWT ──────────────────────────────────────────────────────────
JWT_SECRET="cambiar-por-secreto-largo-y-aleatorio"
JWT_ACCESS_TTL="900"        # 15 min (segundos)
JWT_REFRESH_TTL="2592000"   # 30 días (segundos)

# ── AWS (Rekognition / S3 / KMS) ─────────────────────────────────
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REKOGNITION_COLLECTION_ID="empleados-embeddings"
AWS_S3_BUCKET="asistencia-fotos"
AWS_KMS_KEY_ID=""           # clave de envelope encryption

# ── Fotos y retención ───────────────────────────────────────────
# local para desarrollo; s3 para Vercel/S3/Supabase Storage compatible
PHOTO_STORAGE_PROVIDER="local"
PHOTO_LOCAL_DIR="./data/photos"
PHOTO_ENCRYPTION_KEY=""     # Base64 de exactamente 32 bytes
PHOTO_RETENTION_DAYS="45"
S3_ENDPOINT=""              # opcional: endpoint S3-compatible
S3_FORCE_PATH_STYLE="false"
AWS_S3_SSE="AES256"
CRON_SECRET="cambiar-por-secreto-de-cron"

# ── Reglas de negocio ────────────────────────────────────────────
FACE_MATCH_THRESHOLD="0.95"      # 95%
LIVENESS_THRESHOLD="0.90"
FACE_PROVIDER="local"            # local (face-api.js) | mock | rekognition
GPS_MAX_ACCURACY_M="20"
GEOFENCE_RADIUS_M="150"
GEOFENCE_LAT=""
GEOFENCE_LNG=""
APP_TIMEZONE="America/Guayaquil"
