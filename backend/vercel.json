{
  "version": 2,
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 60
    }
  },
  "installCommand": "pnpm install --frozen-lockfile && pnpm prisma:generate",
  "buildCommand": "pnpm build",
  "crons": [
    {
      "path": "/api/v1/retention/purge",
      "schedule": "0 3 * * *"
    }
  ]
}
