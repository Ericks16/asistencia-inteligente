{
  "version": 2,
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "/api/:path*"
    }
  ],
  "installCommand": "pnpm install --frozen-lockfile && pnpm prisma:generate --schema=./prisma/schema.prisma",
  "buildCommand": "pnpm build",
  "crons": [
    {
      "path": "/api/v1/retention/purge",
      "schedule": "0 3 * * *"
    }
  ]
}
