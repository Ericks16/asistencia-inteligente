{
  "name": "asistencia-inteligente-backend",
  "version": "1.0.0",
  "packageManager": "pnpm@9.15.9",
  "description": "Backend NestJS del Sistema de Control de Asistencia Inteligente",
  "private": true,
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "build": "prisma generate --schema=./prisma/schema.prisma && nest build",
    "postinstall": "prisma generate",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "prisma:generate": "prisma generate --schema=./prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "prisma:seed": "node prisma/seed.mjs",
    "prisma:studio": "prisma studio",
    "test:time": "ts-node src/attendance/time-calculator.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.3.0",
    "@prisma/client": "^5.14.0",
    "prisma": "^5.14.0",
    "@aws-sdk/client-rekognition": "^3.0.0",
    "@aws-sdk/client-s3": "^3.0.0",
    "@aws-sdk/client-kms": "^3.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "uuid": "^9.0.1",
    "@aws-sdk/s3-request-presigner": "^3.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.3.0",
    "@nestjs/schematics": "^10.1.0",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.12.0",
    "@types/passport-jwt": "^4.0.1",
    "@vercel/node": "^5.5.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0"
  }
}
