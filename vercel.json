{
  "version": 2,
  "installCommand": "cd backend && pnpm install --frozen-lockfile && pnpm prisma:generate",
  "buildCommand": "cd backend && pnpm build",
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/v1/auth/login-cedula",
      "destination": "/api/login-cedula"
    }
  ],
  "crons": [
    {
      "path": "/api/v1/retention/purge",
      "schedule": "0 3 * * *"
    }
  ]
}
